cabal-version: 3.0
name: blink
version: 0.1.0.0
license: Apache-2.0
license-file: LICENSE
author: Benjamin Gale
maintainer: benjaminiangale@gmail.com
build-type: Simple
synopsis: A declarative, functional GUI library for Haskell desktop applications
description:
    Blink is a declarative, functional GUI library for Haskell desktop
    applications. You describe your interface as a tree of elements built
    from your application's state, and Blink handles turning that into
    what's drawn on screen and how it responds to input. That declarative
    layer sits on top of a lower-level immediate-mode API, which is there
    if you need to hand-write a custom control. The whole UI tree is
    rebuilt from application state each frame, rather than retained and
    mutated incrementally. Blink does not own the main loop -- a backend
    (SDL2, in the included demo) drives the loop and calls into Blink once
    per frame.

    Start with "Blink" for the module guide, "Blink.App" for how to define
    an application and wire it up to a backend, and "Blink.UI" for the
    monad views are built from.

common defaults
    ghc-options: -Wall
    default-language: Haskell2010
    build-depends:
        base ^>=4.18.3.0,
        containers ^>=0.6.7,
        text ^>=2.0.2

library
    import: defaults
    exposed-modules:
        Blink
        Blink.App
        Blink.Attribute
        Blink.Geometry
        Blink.Input
        Blink.Rendering
        Blink.Style
        Blink.Style.Defaults
        Blink.UI
        Blink.UI.Controls
        Blink.UI.Controls.Button
        Blink.UI.Controls.Checkbox
        Blink.UI.Controls.Control
        Blink.UI.Controls.Divider
        Blink.UI.Controls.Element
        Blink.UI.Controls.Label
        Blink.UI.Controls.ProgressBar
        Blink.UI.Controls.RadioButton
        Blink.UI.Controls.RepeatButton
        Blink.UI.Controls.Slider
        Blink.UI.Controls.TextInput
        Blink.UI.Controls.Toggle
        Blink.UI.Element
        Blink.UI.Layout
        Blink.UI.Layout.Border
        Blink.UI.Layout.Box
        Blink.UI.Layout.Constraints
        Blink.Update
    hs-source-dirs: src

executable demo
    import: defaults
    ghc-options: -threaded
    main-is: Main.hs
    other-modules:
        UI,
        Theme,
        Rendering
    build-depends:
        blink,
        sdl2 ^>=2.5.5,
        sdl2-ttf ^>=2.1.3
    hs-source-dirs: app

test-suite blink-tests
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Blink.AppSpec
        Blink.Generators
        Blink.GeometrySpec
        Blink.InputSpec
        Blink.Interaction
        Blink.InteractionSpec
        Blink.Style.DefaultsSpec
        Blink.UI.Controls.ButtonBehaviour
        Blink.UI.Controls.ButtonSpec
        Blink.UI.Controls.CheckboxSpec
        Blink.UI.Controls.ControlBehaviour
        Blink.UI.Controls.ControlSpec
        Blink.UI.Controls.DividerSpec
        Blink.UI.Controls.ElementBehaviour
        Blink.UI.Controls.ElementSpec
        Blink.UI.Controls.FixedFocusBehaviour
        Blink.UI.Controls.LabelSpec
        Blink.UI.Controls.ProgressBarSpec
        Blink.UI.Controls.RadioButtonSpec
        Blink.UI.Controls.RepeatButtonSpec
        Blink.UI.Controls.SliderSpec
        Blink.UI.Controls.TextInputSpec
        Blink.UI.Controls.ToggleBehaviour
        Blink.UI.Controls.ToggleSpec
        Blink.UI.LayoutSpec
        Blink.UISpec
        Blink.UpdateSpec
    build-depends:
        blink,
        hspec ^>=2.11.17,
        QuickCheck ^>=2.18.0.0
