cabal-version: 3.0
name: blink
version: 0.1.0.0
license: Apache-2.0
license-file: LICENSE
author: Benjamin Gale
maintainer: benjaminiangale@gmail.com
build-type: Simple
synopsis: An immediate-mode UI library for Haskell desktop applications
description:
    Blink is an immediate-mode UI library for Haskell desktop applications:
    the whole UI tree is rebuilt from scratch every frame as a pure function
    of application state, rather than retained and mutated incrementally.
    State changes only through modifiers dispatched by the UI. Blink does
    not own the main loop -- a backend (SDL2, in the included demo) drives
    the loop and calls into Blink once per frame.

    Start with "Blink" for the module guide, "Blink.App" for how to define
    an application and wire it up to a backend, and "Blink.UI" for the
    monad views are built from.

common defaults
    ghc-options: -Wall
    default-language: Haskell2010
    build-depends:
        base ^>=4.18.3.0,
        containers,
        text

library
    import: defaults
    exposed-modules:
        Blink
        Blink.App
        Blink.Attributes
        Blink.Button
        Blink.Checkbox
        Blink.Control
        Blink.Controls
        Blink.Element
        Blink.Label
        Blink.RadioButton
        Blink.TextInput
        Blink.Geometry
        Blink.Input
        Blink.Layout
        Blink.Mouse
        Blink.Rendering
        Blink.Style
        Blink.UI
        Blink.Update
    hs-source-dirs: src

executable demo
    import: defaults
    ghc-options: -threaded
    main-is: Main.hs
    other-modules:
        UI,
        Theme,
        Rendering
    build-depends:
        blink,
        sdl2,
        sdl2-ttf
    hs-source-dirs: app

test-suite blink-tests
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Blink.AppSpec
        Blink.ButtonBehaviour
        Blink.ButtonSpec
        Blink.CheckboxSpec
        Blink.ControlBehaviour
        Blink.ControlSpec
        Blink.ControlsSpec
        Blink.ControlsTestSupport
        Blink.ElementBehaviour
        Blink.ElementSpec
        Blink.Generators
        Blink.GeometrySpec
        Blink.Interaction
        Blink.InteractionSpec
        Blink.LabelSpec
        Blink.LayoutSpec
        Blink.MouseSpec
        Blink.RadioButtonSpec
        Blink.TextInputSpec
        Blink.UISpec
        Blink.UpdateSpec
    build-depends:
        blink,
        hspec,
        QuickCheck
