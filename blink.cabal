cabal-version: 3.0
name: blink
version: 0.1.0.0
license: Apache-2.0
license-file: LICENSE
author: Benjamin Gale
maintainer: benjaminiangale@gmail.com
build-type: Simple
synopsis: A declarative, functional GUI library for Haskell desktop applications
description:
    Blink is a declarative, functional GUI library for Haskell desktop
    applications. You describe your interface as a tree of elements built
    from your application's state, and Blink handles turning that into
    what's drawn on screen and how it responds to input. That declarative
    layer sits on top of a lower-level immediate-mode API, which is there
    if you need to hand-write a custom control. The whole view tree is
    rebuilt from application state each frame, rather than retained and
    mutated incrementally. Blink does not own the main loop -- a backend
    (SDL2, in the included demo) drives the loop and calls into Blink once
    per frame.

    Start with "Blink" for the module guide, "Blink.App" for how to define
    an application and wire it up to a backend, and "Blink.View" for the
    monad views are built from.

common defaults
    ghc-options: -Wall
    default-language: Haskell2010
    build-depends:
        base ^>=4.18.3.0,
        containers ^>=0.6.7,
        text ^>=2.0.2

library
    import: defaults
    exposed-modules:
        Blink
        Blink.App
        Blink.Geometry
        Blink.Input
        Blink.Update
        Blink.View
        Blink.View.Animation
        Blink.View.Attribute
        Blink.View.Controls
        Blink.View.Drawing
        Blink.View.Focus
        Blink.View.Hold
        Blink.View.Navigation
        Blink.View.Scroll
        Blink.View.Selection
        Blink.View.Controls.Button
        Blink.View.Controls.Checkbox
        Blink.View.Controls.Control
        Blink.View.Controls.Divider
        Blink.View.Controls.Label
        Blink.View.Controls.ProgressBar
        Blink.View.Controls.RadioButton
        Blink.View.Controls.RepeatButton
        Blink.View.Controls.ScrollBar
        Blink.View.Controls.Slider
        Blink.View.Controls.TextInput
        Blink.View.Controls.ToggleButton
        Blink.View.Controls.ToggleGroup
        Blink.View.Element
        Blink.View.Layout
        Blink.View.Layout.Border
        Blink.View.Layout.Box
        Blink.View.Layout.Constraints
        Blink.View.Rendering
        Blink.View.Style
        Blink.View.Style.Button
        Blink.View.Style.Checkbox
        Blink.View.Style.Control
        Blink.View.Style.Defaults
        Blink.View.Style.Divider
        Blink.View.Style.Label
        Blink.View.Style.ProgressBar
        Blink.View.Style.RadioButton
        Blink.View.Style.ScrollBar
        Blink.View.Style.Slider
        Blink.View.Style.TextInput
        Blink.View.Style.ToggleButton
        Blink.View.Style.ToggleGroup
    hs-source-dirs: src

executable demo
    import: defaults
    ghc-options: -threaded
    main-is: Main.hs
    other-modules:
        UI,
        Theme,
        Rendering
    build-depends:
        blink,
        sdl2 ^>=2.5.5,
        sdl2-ttf ^>=2.1.3
    hs-source-dirs: app

test-suite blink-tests
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    other-modules:
        Blink.AppSpec
        Blink.Generators
        Blink.GeometrySpec
        Blink.InputSpec
        Blink.Interaction
        Blink.InteractionSpec
        Blink.UpdateSpec
        Blink.View.Controls.ButtonBehaviour
        Blink.View.Controls.ButtonSpec
        Blink.View.Controls.CheckboxSpec
        Blink.View.Controls.ControlBehaviour
        Blink.View.Controls.ControlSpec
        Blink.View.Controls.DividerSpec
        Blink.View.Controls.ElementBehaviour
        Blink.View.Controls.FixedFocusBehaviour
        Blink.View.Controls.FocusScopeSpec
        Blink.View.Controls.LabelSpec
        Blink.View.Controls.ProgressBarSpec
        Blink.View.Controls.RadioButtonSpec
        Blink.View.Controls.RepeatButtonSpec
        Blink.View.Controls.ScrollBarSpec
        Blink.View.Controls.SliderSpec
        Blink.View.Controls.TextInputSpec
        Blink.View.Controls.ToggleBehaviour
        Blink.View.Controls.ToggleButtonSpec
        Blink.View.Controls.ToggleGroupSpec
        Blink.View.LayoutSpec
        Blink.View.Style.DefaultsSpec
        Blink.ViewSpec
    build-depends:
        blink,
        hspec ^>=2.11.17,
        QuickCheck ^>=2.18.0.0
