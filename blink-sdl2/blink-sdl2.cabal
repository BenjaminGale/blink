cabal-version: 3.0
name: blink-sdl2
version: 0.1.0.0
license: Apache-2.0
license-file: LICENSE
author: Benjamin Gale
maintainer: benjaminiangale@gmail.com
build-type: Simple
synopsis: An SDL2 backend for the Blink GUI library
description:
    Runs a Blink application in an SDL2 window: it opens the window,
    measures text with SDL2_ttf and images with SDL2_image, drives
    Blink's event-driven frame loop, and renders each frame's draw
    commands. Start with "Blink.SDL2".

common defaults
    ghc-options: -Wall -Werror
    default-language: Haskell2010
    build-depends:
        base ^>=4.18.3.0,
        blink,
        containers ^>=0.6.7,
        text ^>=2.0.2

library
    import: defaults
    exposed-modules:
        Blink.SDL2
    other-modules:
        Blink.SDL2.Fonts
        Blink.SDL2.Input
        Blink.SDL2.Rendering
    build-depends:
        sdl2 ^>=2.5.5,
        sdl2-image ^>=2.1.0,
        sdl2-ttf ^>=2.1.3,
        stm ^>=2.5.1,
        vector
    hs-source-dirs: src

executable demo
    import: defaults
    ghc-options: -threaded
    main-is: Main.hs
    other-modules:
        UI,
        Theme
    build-depends:
        blink-sdl2
    hs-source-dirs: demo
